# Copy to .env.local for Next.js locally, or add in Vercel > Environment Variables.
# These are server-only values. Never prefix them with NEXT_PUBLIC_.
# Leave all three empty for the visual demonstration without persisted residents.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=
# Optional, minimum 32 random characters; admin API uses Authorization: Bearer.
MAP_ADMIN_TOKEN=
# Instagram can remain off while choosing the account and campaign.
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_MEDIA_IDS=
INSTAGRAM_PROFILE=
